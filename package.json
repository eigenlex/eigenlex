{
  "name": "eigenlex",
  "version": "0.0.0",
  "private": true,
  "description": "eigenlex — a vocabulary learning tool: every English word placed on a frequency and CEFR learning band.",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "skills:sync": "node scripts/sync-next-skills.mjs && npx -y skills@latest update -y",
    "skills:check": "node scripts/check-fondue-install.mjs && node scripts/sync-next-skills.mjs --check",
    "decode:check": "node scripts/check-deployed-decodes.mjs"
  },
  "devDependencies": {
    "turbo": "^2.10.11",
    "typescript": "^5.9.2"
  }
}
